[
    {"text": "내가 바로 문을 두드리는 사람이다!", "author": "월터 화이트"},
    {"text": "그래, 과학이야, 이 자식아!", "author": "제시 핑크맨"},
    {"text": "내 이름을 말해봐.", "author": "월터 화이트"},
    {"text": "나는 제국을 건설하는 사업을 하고 있어.", "author": "월터 화이트"},
    {"text": "솔을 불러!", "author": "사울 굿맨"},
    {"text": "난 나를 위해 한 거야. 그리고 난 그걸 잘했어.", "author": "월터 화이트"},
    {"text": "어중간한 건 없어.", "author": "마이크 어먼트라우트"},
    {"text": "조심해서 행동해.", "author": "월터 화이트"},
    {"text": "난 위험에 처한 게 아니야, 스카일러. 내가 바로 위험이야.", "author": "월터 화이트"},
    {"text": "제시, 요리를 해야 해.", "author": "월터 화이트"},
    {"text": "남자는 가족을 부양하는 법이지.", "author": "구스타보 프링"},
    {"text": "닥치고 조용히 죽게 내버려 둬.", "author": "마이크 어먼트라우트"},
    {"text": "내가 이겼어.", "author": "월터 화이트"},
    {"text": "배우기에 너무 늦은 나이란 없어.", "author": "월터 화이트"},
    {"text": "거스 프링을 죽인 사람이 바로 나야.", "author": "월터 화이트"},
    {"text": "약쟁이는 절대 믿지 마.", "author": "스키니 피트"},
    {"text": "사람은 변하지 않아.", "author": "월터 화이트"},
    {"text": "넌 시한폭탄이야.", "author": "구스타보 프링"},
    {"text": "현명하게 선택해.", "author": "구스타보 프링"},
    {"text": "가족을 지키는 사람으로부터 이 가족을 지켜야 할 누군가가 필요하네.", "author": "스카일러 화이트"},
    {"text": "대니, 네가 나쁜 경찰이라고 생각하지 않아.", "author": "마이크 어먼트라우트"},
    {"text": "넌 그 사람이 아니야. 그 사람이 될 능력도 없지.", "author": "마이크 어먼트라우트"},
    {"text": "음주운전 하지 마, 하지만 하게 되면 나한테 전화해.", "author": "사울 굿맨"},
    {"text": "내 아이들을 돌려줘.", "author": "제시 핑크맨"},
    {"text": "내가 한 모든 건, 우리 가족을 위한 거였어.", "author": "월터 화이트"},
    {"text": "제시 제임스를 쐈다고 해서 네가 제시 제임스가 되는 건 아니야.", "author": "마이크 어먼트라우트"},
    {"text": "내가 끝났다고 말할 때가 끝난 거야.", "author": "월터 화이트"},
    {"text": "난 범죄자야, 요.", "author": "제시 핑크맨"},
    {"text": "열심히 해.", "author": "월터 화이트"},
    {"text": "딱 걸렸군.", "author": "월터 화이트"},
    {"text": "난 범죄자가 아니라, 범죄 전문 변호사야.", "author": "사울 굿맨"},
    {"text": "내 구역에서 나가.", "author": "월터 화이트"},
    {"text": "이건 마약이 아니야.", "author": "월터 화이트"},
    {"text": "오늘 운이 좋은 날인가?", "author": "투코 살라만카"},
    {"text": "최고야! 끝내줘!", "author": "투코 살라만카"},
    {"text": "용서할게.", "author": "제시 핑크맨"},
    {"text": "끝났어. 해고야.", "author": "구스타보 프링"},
    {"text": "이 순간을 정말 오래 기다려왔어.", "author": "월터 화이트"},
    {"text": "살아있니?", "author": "제시 핑크맨"},
    {"text": "무슨 일이 있어도 욕심내지 마.", "author": "마이크 어먼트라우트"},
    {"text": "그를 벨리즈로 여행 보내버려.", "author": "사울 굿맨"},
    {"text": "난 깨어있어.", "author": "월터 화이트"},
    {"text": "넌 빌어먹을 마약상이야.", "author": "제시 핑크맨"},
    {"text": "우리 같은 건 없어.", "author": "월터 화이트"},
    {"text": "모든 건 화학에 달렸어.", "author": "월터 화이트"},
    {"text": "게임은 게임일 뿐이야.", "author": "마이크 어먼트라우트"},
    {"text": "날 믿어줬으면 해.", "author": "제시 핑크맨"},
    {"text": "뭐, 훈장이라도 바라는 거야?", "author": "마이크 어먼트라우트"},
    {"text": "난 마약 사업을 하고 있어.", "author": "월터 화이트"},
    {"text": "넌 나의 프리패스야.", "author": "월터 화이트"},
    {"text": "내가 왕이야.", "author": "월터 화이트"},
    {"text": "난 제조업자야.", "author": "월터 화이트"},
    {"text": "넌 바보야.", "author": "월터 화이트"},
    {"text": "난 나쁜 사람이 아니야.", "author": "제시 핑크맨"},
    {"text": "해야 할 일이 있어.", "author": "마이크 어먼트라우트"},
    {"text": "사업을 하는 데 드는 비용이지.", "author": "마이크 어먼트라우트"},
    {"text": "피해자 코스프레 하지 마.", "author": "월터 화이트"},
    {"text": "난 영웅이 아니야.", "author": "월터 화이트"},
    {"text": "난 그저 내 돈을 원할 뿐이야.", "author": "제시 핑크맨"},
    {"text": "난 내가 아는 사람 중 가장 똑똑해.", "author": "월터 화이트"},
    {"text": "끝났어.", "author": "월터 화이트"},
    {"text": "넌 내가 만난 사람 중 가장 똑똑해.", "author": "행크 슈레이더"},
    {"text": "내 이름은 ASAC 슈레이더다.", "author": "행크 슈레이더"},
    {"text": "세상에, 마리! 이건 광물이라고!", "author": "행크 슈레이더"},
    {"text": "널 죽여버릴 거야.", "author": "월터 화이트"},
    {"text": "미안해.", "author": "제시 핑크맨"},
    {"text": "이제 네가 누군지 모르겠어.", "author": "스카일러 화이트"},
    {"text": "이게 최선이야.", "author": "월터 화이트"},
    {"text": "난 절대 거짓말 안 했어.", "author": "월터 화이트"},
    {"text": "넌 좋은 사람이 아니야.", "author": "제시 핑크맨"},
    {"text": "난 나 그대로야.", "author": "월터 화이트"},
    {"text": "갈 시간이야.", "author": "월터 화이트"},
    {"text": "행운을 빌어.", "author": "마이크 어먼트라우트"},
    {"text": "그걸 한 건 바로 나야.", "author": "월터 화이트"},
    {"text": "우린 가족이잖아.", "author": "월터 화이트"},
    {"text": "지쳤어.", "author": "월터 화이트"},
    {"text": "모든 게 괜찮아질 거야.", "author": "월터 화이트"},
    {"text": "끝났어.", "author": "월터 화이트"},
    {"text": "어쩔 셈이야?", "author": "제시 핑크맨"},
    {"text": "네 돈은 필요 없어.", "author": "제시 핑크맨"},
    {"text": "난 사람이야.", "author": "제시 핑크맨"},
    {"text": "넌 날 몰라.", "author": "제시 핑크맨"},
    {"text": "난 자유야.", "author": "제시 핑크맨"},
    {"text": "가자.", "author": "제시 핑크맨"},
    {"text": "난 살인자가 아니야.", "author": "제시 핑크맨"},
    {"text": "난 제시 핑크맨이야.", "author": "제시 핑크맨"},
    {"text": "인생은 아름다워.", "author": "월터 화이트"},
    {"text": "이제 끝났어.", "author": "월터 화이트"},
    {"text": "정말 사랑했어.", "author": "월터 화이트"},
    {"text": "난 살아있었어.", "author": "월터 화이트"},
    {"text": "안녕.", "author": "월터 화이트"},
    {"text": "모든 게 다 끝났어.", "author": "월터 화이트"},
    {"text": "난 행복해.", "author": "월터 화이트"},
    {"text": "끝이야.", "author": "월터 화이트"},
    {"text": "그냥... 잘 지내.", "author": "제시 핑크맨"},
    {"text": "이제 남은 게 없어.", "author": "월터 화이트"},
    {"text": "이게 끝이야.", "author": "월터 화이트"},
    {"text": "집에 왔어.", "author": "월터 화이트"},
    {"text": "안녕히 계세요, 화이트 씨.", "author": "제시 핑크맨"},
    {"text": "그래.", "author": "제시 핑크맨"}
]
